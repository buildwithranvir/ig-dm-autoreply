# Copy to .env and fill in. Never commit .env.

# --- Instagram app ---
# App Dashboard > Use cases > Manage messaging & content on Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Optional: App settings > Basic > App secret. Only needed if dashboard test events are signed with it.
META_APP_SECRET=
# "Generate access tokens" on the same page (long-lived, about 60 days; refreshed automatically)
IG_ACCESS_TOKEN=
# Printed by: python scripts/whoami.py
IG_USER_ID=
# Any random string; paste the same value as the webhook "Verify token" in the dashboard
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v25.0

# --- Bot ---
OWNER_NAME=Ranvir
# Instagram-scoped ID of your alert account (DM your main account from it; the sender id is in the logs)
OWNER_ALERT_IGSID=
# Non-followers need a profile picture and at least this many followers; verified accounts always pass
REQUEST_MIN_FOLLOWERS=10
MAX_AUTO_DMS_PER_HOUR=100
MAX_REPLIES_PER_THREAD_PER_DAY=30
BOT_ENABLED=true

# --- AI (any OpenAI-compatible API) ---
# Groq key: console.groq.com > API Keys > Create API Key (starts with gsk_)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# low / medium / high for reasoning models like gpt-oss; leave empty for other models
LLM_REASONING_EFFORT=low

# --- Hosting ---
# Any random string; protects /cron/refresh-token (Vercel Cron sends it automatically)
CRON_SECRET=
# Upstash Redis. Set automatically on Vercel; leave empty locally to use in-memory storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
